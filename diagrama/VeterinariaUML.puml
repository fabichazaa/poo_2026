@startuml VeterinariaUML

title Sistema de Gestión Veterinaria — Happy Paws\nDiagrama de Clases UML

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor<<enum>> #FFF4E6
    BackgroundColor<<abstract>> #E8F4FD
    BackgroundColor<<report>> #F0FDF4
    BorderColor #555
    ArrowColor #555
}
hide empty methods

' ============================================================
'                         ENUMS
' ============================================================
enum TipoTurno <<enum>> {
    CONSULTA_GENERAL
    VACUNACION
    CIRUGIA
    BANIO
    ANALISIS
    --
    - descripcion : String
    - duracionMinutos : int
    --
    + getDescripcion() : String
    + getDuracionMinutos() : int
}

enum TipoAlimentacion <<enum>> {
    OMNIVORO
    CARNIVORO_ESTRICTO
    HERBIBORO
    --
    - descripcion : String
    --
    + getDescripcion() : String
}

' ============================================================
'                     CLASES DE SOPORTE
' ============================================================
class Direccion {
    - calle : String
    - numero : int
    - localidad : String
    --
    + Direccion(calle: String, numero: int, localidad: String)
    + actualizarDireccion(calle: String, numero: int, localidad: String) : void
    + getDireccionCompleta() : String
    + toString() : String
}

' ============================================================
'                    JERARQUÍA DE PERSONAS
' ============================================================
abstract class Persona <<abstract>> {
    - DNI : String {final}
    - nombre : String
    - apellido : String
    - direccion : Direccion
    --
    + Persona(DNI: String, nombre: String, apellido: String, direccion: Direccion)
    + Persona(DNI: String, nombre: String, apellido: String)
    + getDNI() : String
    + getNombre() : String
    + getApellido() : String
    + getDireccion() : Direccion
    + getDireccionCompleta() : String
    + setNombre(nombre: String) : void
    + setApellido(apellido: String) : void
    + setDireccion(direccion: Direccion) : void
}

class Veterinario {
    - matricula : String
    - turnos : List<Turno>
    - especialidad : String
    - turnoTrabajo : String
    --
    + Veterinario(DNI: String, nombre: String, apellido: String, direccion: Direccion, matricula: String)
    + Veterinario(DNI: String, nombre: String, apellido: String, matricula: String)
    + getMatricula() : String
    + setMatricula(matricula: String) : void
    + getEspecialidad() : String
    + setEspecialidad(especialidad: String) : void
    + getTurnoTrabajo() : String
    + setTurnoTrabajo(turnoTrabajo: String) : void
    + getRutaFoto() : String
    + getTurnos() : List<Turno>
    + agregarTurno(t: Turno) : void
}

class Responsable {
    - mascotas : ArrayList<Animal>
    --
    + Responsable(DNI: String, nombre: String, apellido: String, direccion: Direccion)
    + Responsable(DNI: String, nombre: String, apellido: String)
    + agregarMascota(animal: Animal) : void
    + removerMascota(animal: Animal) : void
    + getMascotas() : ArrayList<Animal>
}

' ============================================================
'                    JERARQUÍA DE ANIMALES
' ============================================================
abstract class Animal <<abstract>> {
    - idAnimal : String {final}
    - nombre : String
    - fechaNacimiento : LocalDate
    - sexo : boolean {final}
    - responsable : Responsable
    - historiaClinica : HistoriaClinica {final}
    - enAdopcion : boolean
    --
    + Animal(nombre: String, fechaNacimiento: LocalDate, sexo: boolean, responsable: Responsable)
    + Animal(nombre: String, fechaNacimiento: LocalDate, sexo: boolean)
    + getIdAnimal() : String
    + getNombre() : String
    + setNombre(nombre: String) : void
    + getFechaNacimiento() : LocalDate
    + setFechaNacimiento(fechaNacimiento: LocalDate) : void
    + isSexo() : boolean
    + getResponsable() : Responsable
    + setResponsable(responsable: Responsable) : void
    + getHistorial() : HistoriaClinica
    + isEnAdopcion() : boolean
    + setEnAdopcion(enAdopcion: boolean) : void
    + calcularEdad() : int
    + getRutaFoto() : String
    + {abstract} getTipoAlimentacion() : TipoAlimentacion
    + {abstract} getEspecie() : String
    + toString() : String
}

class Perro {
    - raza : String
    - necesitaPaseo : boolean
    --
    + Perro(nombre: String, fechaNacimiento: LocalDate, sexo: boolean, responsable: Responsable, raza: String)
    + Perro(nombre: String, fechaNacimiento: LocalDate, sexo: boolean, raza: String)
    + getRaza() : String
    + setRaza(raza: String) : void
    + isNecesitaPaseo() : boolean
    + setNecesitaPaseo(necesitaPaseo: boolean) : void
    + getTipoAlimentacion() : TipoAlimentacion
    + getEspecie() : String
    + getRutaFoto() : String
}

class Gato {
    - raza : String
    - esEsterilizado : boolean
    --
    + Gato(nombre: String, fechaNacimiento: LocalDate, sexo: boolean, responsable: Responsable, raza: String)
    + Gato(nombre: String, fechaNacimiento: LocalDate, sexo: boolean, raza: String)
    + getRaza() : String
    + setRaza(raza: String) : void
    + isEsEsterilizado() : boolean
    + setEsEsterilizado(esEsterilizado: boolean) : void
    + getTipoAlimentacion() : TipoAlimentacion
    + getEspecie() : String
    + getRutaFoto() : String
}

' ============================================================
'                    HISTORIA CLÍNICA Y MEDICAMENTOS
' ============================================================
class HistoriaClinica {
    - medicamentosRecetados : ArrayList<Prescripcion>
    - registroVacunas : ArrayList<RegistroVacunacion>
    --
    + HistoriaClinica()
    + recetarMedicamento(med: Medicamento) : void
    + recetarMedicamento(pres: Prescripcion) : void
    + registrarVacuna(reg: RegistroVacunacion) : void
    + getMedicamentosRecetados() : ArrayList<Prescripcion>
    + getRegistroVacunas() : ArrayList<RegistroVacunacion>
}

class Medicamento {
    - codigoSenasa : String
    - nombreMedicamento : String
    - subtitulo : String
    --
    + Medicamento(codigoSenasa: String, nombreMedicamento: String)
    + Medicamento(codigoSenasa: String, nombreMedicamento: String, subtitulo: String)
    + getCodigoSenasa() : String
    + getNombreMedicamento() : String
    + getSubtitulo() : String
    + setSubtitulo(subtitulo: String) : void
}

class Prescripcion {
    - medicamento : Medicamento
    - dosis : String
    - viaAdministracion : String
    - frecuencia : String
    - fechaInicio : LocalDate
    - vigenciaDias : int
    - indicaciones : String
    - esMagistral : boolean
    --
    + Prescripcion(medicamento: Medicamento, dosis: String, viaAdministracion: String, frecuencia: String, fechaInicio: LocalDate, vigenciaDias: int, indicaciones: String, esMagistral: boolean)
    + Prescripcion(medicamento: Medicamento)
    + getMedicamento() : Medicamento
    + getDosis() : String
    + getViaAdministracion() : String
    + getFrecuencia() : String
    + getFechaInicio() : LocalDate
    + getVigenciaDias() : int
    + getIndicaciones() : String
    + isEsMagistral() : boolean
    + getNombreMedicamento() : String
    + getCodigoSenasa() : String
}

class Vacuna {
    - vigenciaDias : int
    --
    + Vacuna(codigoSenasa: String, nombreMedicamento: String, vigenciaDias: int)
    + getVigenciaDias() : int
}

class RegistroVacunacion {
    - vacunaAplicada : Vacuna
    - fechaAplicacion : LocalDate
    - fechaVencimiento : LocalDate
    - tipoDosis : String
    - via : String
    - lote : String
    - observaciones : String
    --
    + RegistroVacunacion(vacunaAplicada: Vacuna, fechaAplicacion: LocalDate)
    + RegistroVacunacion(vacunaAplicada: Vacuna, fechaAplicacion: LocalDate, tipoDosis: String, via: String, lote: String, observaciones: String)
    + getVacunaAplicada() : Vacuna
    + getFechaAplicacion() : LocalDate
    + getFechaVencimiento() : LocalDate
    + estaVencida() : boolean 
    + getTipoDosis() : String
    + getVia() : String
    + getLote() : String
    + getObservaciones() : String
}

' ============================================================
'                          TURNOS
' ============================================================  
class Turno {
    + {static} ESTADO_PENDIENTE : String = "Pendiente"
    + {static} ESTADO_COMPLETADO : String = "Completado"
    + {static} ESTADO_CANCELADO : String = "Cancelado"
    - idTurno : int
    - fecha : String
    - hora : String
    - veterinario : Veterinario
    - animal : Animal
    - estado : String
    - tipo : TipoTurno
    - observaciones : String
    --
    + Turno(idTurno: int, fecha: String, hora: String, veterinario: Veterinario, animal: Animal, tipo: TipoTurno, observaciones: String)
    + Turno(fecha: String, hora: String, veterinario: Veterinario, animal: Animal, tipo: TipoTurno)
    + completarTurno() : void
    + cancelarTurno() : void
    + esPendiente() : boolean
    + estaCompletado() : boolean
    + getters/setters() : void
}

' ============================================================
'                  CONTEXTO DEL SISTEMA
' ============================================================
class Veterinaria {
    - nombreNegocio : String
    - listaVeterinarios : ArrayList<Veterinario>
    - listaClientes : ArrayList<Responsable>
    - listaTurnos : ArrayList<Turno>
    - catalogoMedicamentos : ArrayList<Medicamento>
    - pacientesRegistrados : ArrayList<Animal>
    --
    + Veterinaria(nombreNegocio: String)
    + Veterinaria(nombreNegocio: String, autoSembrar: boolean)
    + getNombreNegocio() : String
    + setNombreNegocio(nombre: String) : void
    + registrarVeterinario(v: Veterinario) : void
    + registrarCliente(d: Responsable) : void
    + registrarTurno(t: Turno) : void
    + registrarPaciente(a: Animal) : void
    + agregarMedicamentoAlCatalogo(m: Medicamento) : void
    + buscarVeterinarioPorMatricula(matricula: String) : Veterinario
    + buscarVeterinarioPorDni(dni: String) : Veterinario
    + buscarClientePorDni(dni: String) : Responsable
    + buscarMascotasPorNombre(nombre: String) : ArrayList<Animal>
    + obtenerTurnosPorFecha(fecha: String) : ArrayList<Turno>
    + obtenerTurnosDeVeterinario(v: Veterinario) : ArrayList<Turno>
    + obtenerTurnosPendientes() : ArrayList<Turno>
    + obtenerTurnosCompletados() : ArrayList<Turno>
    + obtenerTodosLosAnimales() : ArrayList<Animal>
    + obtenerAnimalesEnAdopcion() : ArrayList<Animal>
    + contarTurnosDelDia(fecha: String) : int
    + getters() : void
}

' ============================================================
'                  CLASE DE REPORTE (Req. f)
' ============================================================
class ComprobanteTurno {
    - turno : Turno
    - fechaEmision : LocalDateTime
    - nombreVeterinaria : String
    --
    + ComprobanteTurno(turno: Turno)
    + ComprobanteTurno(turno: Turno, nombreVeterinaria: String)
    + getTurno() : Turno
    + getFechaEmision() : LocalDateTime
    + generarEncabezado() : String
    + generarDetallePaciente() : String
    + generarDetalleAtencion() : String
    + generarDetalleTratamiento() : String
    + generarTextoCompleto() : String
    + marcarComoCompletado() : void
}

' ============================================================
'                        HERENCIA
' ============================================================
Persona <|-- Responsable
Persona <|-- Veterinario
Animal <|-- Perro
Animal <|-- Gato
Medicamento <|-- Vacuna

' ============================================================
'                  ASOCIACIONES Y CARDINALIDADES
' ============================================================

Persona "1" --> "0..1" Direccion : reside en >
Animal "1" *-- "1" HistoriaClinica : tiene >
Responsable "1" o-- "0..*" Animal : es dueño de >
Turno "0..*" --> "1" Veterinario : atendido por >
Turno "0..*" --> "1" Animal : para >
Turno "0..*" --> "1" TipoTurno : de tipo >
Animal ..> TipoAlimentacion : clasifica según >
Veterinaria "1" *-- "0..*" Veterinario : emplea >
Veterinaria "1" *-- "0..*" Responsable : registra >
Veterinaria "1" *-- "0..*" Turno : agenda >
Veterinaria "1" o-- "0..*" Medicamento : cataloga >
HistoriaClinica "1" *-- "0..*" Prescripcion : contiene >
Prescripcion "0..*" --> "1" Medicamento : receta >
HistoriaClinica "1" *-- "0..*" RegistroVacunacion : muestra >
RegistroVacunacion "0..*" --> "1" Vacuna : contiene >

ComprobanteTurno ..> Turno : presenta >
ComprobanteTurno ..> Animal
ComprobanteTurno ..> Veterinario
ComprobanteTurno ..> Responsable
ComprobanteTurno ..> HistoriaClinica
ComprobanteTurno ..> RegistroVacunacion

@enduml